{
  "expo": {
    "name": "Qistak",
    "slug": "qistak",
    "version": "1.0.0",
    "scheme": "qistak",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qistak.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.qistak.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
