{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.qistak.com",
        "EXPO_PUBLIC_SITE_URL": "https://qistak.com",
        "EXPO_PUBLIC_ROOT_DOMAIN": "qistak.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.qistak.com",
        "EXPO_PUBLIC_SITE_URL": "https://qistak.com",
        "EXPO_PUBLIC_ROOT_DOMAIN": "qistak.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.qistak.com",
        "EXPO_PUBLIC_SITE_URL": "https://qistak.com",
        "EXPO_PUBLIC_ROOT_DOMAIN": "qistak.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6812921778"
      }
    }
  }
}
