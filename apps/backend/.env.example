DATABASE_URL="postgresql://installment:installment@localhost:5433/installment"
JWT_SECRET="dev-only-change-me-in-production"
JWT_EXPIRES_IN="7d"
TWO_FACTOR_ENCRYPTION_KEY="" # any random string, 32+ chars — used to encrypt TOTP secrets at rest, e.g. `openssl rand -hex 32`
PLATFORM_ADMIN_EMAIL="" # creates the platform owner account on boot if it does not exist yet
PLATFORM_ADMIN_PASSWORD="" # 12+ chars, only read when that account is first created
PLATFORM_ADMIN_NAME="Platform Admin"
REDIS_HOST="localhost"
REDIS_PORT="6380"
# REDIS_URL="redis://default:password@host:port" # set this instead of REDIS_HOST/REDIS_PORT on Railway
PORT="3001"
LOG_LEVEL="debug" # fatal | error | warn | info | debug | trace — leave at "info" or unset in production
LOG_PRETTY="true" # colorized single-line logs for local dev — leave unset (JSON) in production
FRONTEND_URL="http://localhost:3000" # comma-separated to allow more than one origin, e.g. "https://app.example.com,https://staging.example.com"
RESEND_API_KEY="" # from resend.com/api-keys — required for forgot/reset-password emails to actually send
RESEND_FROM_EMAIL="" # e.g. "Qistak <no-reply@qistak.com>" — the sending domain must be verified in Resend
TELEGRAM_BOT_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID="" # shared across all tenants — the phone number ID (not the WABA ID) from your Meta app's WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN="" # permanent System User token for the same Meta app
REMINDER_HOUR="8"
EVENING_SUMMARY_HOUR="20"
UPLOADS_DIR="./uploads"
STORAGE_PROVIDER="backblaze" # "backblaze" (default) or "local"
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET=""
B2_ENDPOINT="" # e.g. https://s3.us-west-004.backblazeb2.com
B2_REGION="us-west-004"
# Bucket can stay Private — the backend proxies reads through /assets/* using short-lived signed URLs.
