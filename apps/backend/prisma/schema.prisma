generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecurrenceType {
  MONTHLY
  EVERY_X_DAYS
  WEEKLY
  BIWEEKLY
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum CalculationMethod {
  FIXED_COUNT
  FIXED_AMOUNT
  MARKUP_PERCENT
}

enum NotificationLanguage {
  AR
  EN
}

enum ReminderChannel {
  TELEGRAM
  WHATSAPP
}

enum BroadcastAudience {
  ALL
  SELECTED
}

enum BroadcastStatus {
  QUEUED
  SENDING
  DONE
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
}

enum Role {
  ADMIN
  STAFF
}

enum PaymentClaimStatus {
  PENDING
  APPROVED
  DECLINED
}

enum PaymentDirection {
  IN
  OUT
}

enum BrandColor {
  emerald
  teal
  blue
  indigo
  violet
  rose
  amber
  slate
}

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  displayName        String?
  logoUrl            String?
  brandColor         BrandColor         @default(emerald)
  showPublicPricing  Boolean            @default(true)
  phone              String?
  about              String?
  instagramUrl       String?
  facebookUrl        String?
  tiktokUrl          String?
  showInstallmentCalculator Boolean     @default(false)
  calculatorPlans    Json               @default("[]")
  locations          Json               @default("[]")
  telegramBotToken   String?
  telegramBotUsername String?
  telegramChatId     String?
  notificationLanguage NotificationLanguage @default(AR)
  createdAt          DateTime           @default(now())
  users              User[]
  customers          Customer[]
  contracts          Contract[]
  installments       Installment[]
  payments           Payment[]
  reminderLogs       ReminderLog[]
  broadcasts         Broadcast[]
  broadcastRecipients BroadcastRecipient[]
  auditLogs          AuditLog[]
  paymentMethods     PaymentMethod[]
  paymentMethodTransactions PaymentMethodTransaction[]
  paymentClaims      PaymentClaim[]
  customerNotificationLogs CustomerNotificationLog[]
}

model User {
  id                        String     @id @default(cuid())
  tenantId                  String
  name                      String
  email                     String     @unique
  passwordHash              String
  role                      Role       @default(ADMIN)
  isActive                  Boolean    @default(true)
  twoFactorSecret           String?
  twoFactorEnabled          Boolean    @default(false)
  createdAt                 DateTime   @default(now())
  tenant                    Tenant     @relation(fields: [tenantId], references: [id])
  auditLogs                 AuditLog[]
  reviewedPaymentClaims     PaymentClaim[]
  twoFactorBackupCodes      TwoFactorBackupCode[]

  @@index([tenantId, role])
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  userName   String
  userEmail  String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model Customer {
  id        String     @id @default(cuid())
  tenantId  String
  publicId  String     @unique @default(uuid())
  name      String
  phone     String
  address   String?
  notes     String?
  idImageUrl String?
  telegramChatId               String?
  telegramNotificationsEnabled Boolean @default(true)
  telegramBroadcastsEnabled    Boolean @default(true)
  notificationLanguage         NotificationLanguage @default(AR)
  broadcastRecipients          BroadcastRecipient[]
  notificationLogs             CustomerNotificationLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  contracts Contract[]

  @@index([tenantId, name])
  @@index([tenantId, phone])
}

model Contract {
  id                String            @id @default(cuid())
  tenantId          String
  customerId        String
  publicId          String            @unique @default(uuid())
  productName       String
  productPrice      Int
  costPrice         Int?
  downPayment      Int
  totalAmount       Int
  calculationMethod CalculationMethod
  markupPercent     Float?
  installmentCount  Int
  recurrenceType    RecurrenceType
  intervalDays      Int?
  startDate         DateTime          @db.Date
  firstPaymentDate  DateTime          @db.Date
  status            ContractStatus    @default(ACTIVE)
  imageUrl          String?
  createdAt         DateTime          @default(now())
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  customer          Customer          @relation(fields: [customerId], references: [id])
  installments      Installment[]
  payments          Payment[]
  paymentClaims     PaymentClaim[]

  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model Installment {
  id          String              @id @default(cuid())
  tenantId    String
  contractId  String
  sequence    Int
  dueDate     DateTime            @db.Date
  amount      Int
  paidAmount  Int                 @default(0)
  status      InstallmentStatus   @default(PENDING)
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  contract    Contract            @relation(fields: [contractId], references: [id])
  allocations PaymentAllocation[]
  paymentClaims PaymentClaim[]

  @@unique([contractId, sequence])
  @@index([tenantId, dueDate, status])
}

model Payment {
  id              String              @id @default(cuid())
  tenantId        String
  contractId      String
  paymentMethodId String?
  amount          Int
  paidAt          DateTime            @default(now())
  note            String?
  createdAt       DateTime            @default(now())
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  contract        Contract            @relation(fields: [contractId], references: [id])
  paymentMethod   PaymentMethod?      @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  allocations     PaymentAllocation[]

  @@index([tenantId, paidAt])
  @@index([tenantId, contractId])
  @@index([tenantId, paymentMethodId, paidAt])
}

model PaymentAllocation {
  id            String      @id @default(cuid())
  tenantId      String
  paymentId     String
  installmentId String
  amount        Int
  payment       Payment     @relation(fields: [paymentId], references: [id])
  installment   Installment @relation(fields: [installmentId], references: [id])

  @@index([tenantId])
  @@index([paymentId])
  @@index([installmentId])
}

model ReminderLog {
  id       String          @id @default(cuid())
  tenantId String
  channel  ReminderChannel @default(TELEGRAM)
  sentAt   DateTime        @default(now())
  success  Boolean
  error    String?
  tenant   Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId, sentAt])
}

model CustomerNotificationLog {
  id         String          @id @default(cuid())
  tenantId   String
  customerId String
  channel    ReminderChannel @default(TELEGRAM)
  success    Boolean
  error      String?
  sentAt     DateTime        @default(now())
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId, sentAt])
}

model Broadcast {
  id         String              @id @default(cuid())
  tenantId   String
  body       String
  hasImage   Boolean             @default(false)
  audience   BroadcastAudience
  status     BroadcastStatus     @default(QUEUED)
  createdAt  DateTime            @default(now())
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  recipients BroadcastRecipient[]

  @@index([tenantId, createdAt])
}

model BroadcastRecipient {
  id          String                   @id @default(cuid())
  tenantId    String
  broadcastId String
  customerId  String
  status      BroadcastRecipientStatus @default(PENDING)
  sentAt      DateTime?
  error       String?
  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  broadcast   Broadcast                @relation(fields: [broadcastId], references: [id])
  customer    Customer                 @relation(fields: [customerId], references: [id])

  @@index([broadcastId, status])
  @@index([customerId])
  @@index([tenantId])
}

model PaymentMethod {
  id                  String                     @id @default(cuid())
  tenantId            String
  label               String
  details             String
  presetKey           String?
  isActive            Boolean                    @default(true)
  sortOrder           Int                        @default(0)
  monthlyLimit        Int?
  lastLimitAlertMonth String?
  createdAt           DateTime                   @default(now())
  tenant              Tenant                     @relation(fields: [tenantId], references: [id])
  claims              PaymentClaim[]
  payments            Payment[]
  transactions        PaymentMethodTransaction[]

  @@unique([tenantId, presetKey, details])
  @@index([tenantId, isActive])
}

model PaymentMethodTransaction {
  id                String           @id @default(cuid())
  tenantId          String
  paymentMethodId   String
  direction         PaymentDirection
  amount            Int
  counterpartyName  String?
  counterpartyPhone String?
  receiptUrl        String?
  note              String?
  occurredAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  paymentMethod     PaymentMethod    @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([tenantId, paymentMethodId, occurredAt])
}

model PaymentClaim {
  id               String             @id @default(cuid())
  tenantId         String
  contractId       String
  installmentId    String?
  paymentMethodId  String
  amount           Int
  screenshotUrl    String
  status           PaymentClaimStatus @default(PENDING)
  declineReason    String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  contract         Contract           @relation(fields: [contractId], references: [id])
  installment      Installment?       @relation(fields: [installmentId], references: [id])
  paymentMethod    PaymentMethod      @relation(fields: [paymentMethodId], references: [id])
  reviewedBy       User?              @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([installmentId])
  @@index([tenantId, contractId])
  @@index([paymentMethodId])
}
