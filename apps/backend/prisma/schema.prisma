generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecurrenceType {
  MONTHLY
  EVERY_X_DAYS
  WEEKLY
  BIWEEKLY
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum CalculationMethod {
  FIXED_COUNT
  FIXED_AMOUNT
  MARKUP_PERCENT
}

enum AllocationStrategy {
  OLDEST_FIRST
}

enum NotificationLanguage {
  AR
  EN
}

enum BroadcastAudience {
  ALL
  SELECTED
}

enum BroadcastStatus {
  QUEUED
  SENDING
  DONE
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
}

enum Role {
  ADMIN
  STAFF
}

enum PaymentClaimStatus {
  PENDING
  APPROVED
  DECLINED
}

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  displayName        String?
  logoUrl            String?
  brandColor         String             @default("emerald")
  showPublicPricing  Boolean            @default(true)
  phone              String?
  about              String?
  instagramUrl       String?
  facebookUrl        String?
  tiktokUrl          String?
  showInstallmentCalculator Boolean     @default(false)
  calculatorPlans    Json               @default("[]")
  locations          Json               @default("[]")
  telegramBotToken   String?
  telegramBotUsername String?
  telegramChatId     String?
  notificationLanguage NotificationLanguage @default(AR)
  allocationStrategy AllocationStrategy @default(OLDEST_FIRST)
  createdAt          DateTime           @default(now())
  users              User[]
  customers          Customer[]
  contracts          Contract[]
  installments       Installment[]
  payments           Payment[]
  reminderLogs       ReminderLog[]
  broadcasts         Broadcast[]
  broadcastRecipients BroadcastRecipient[]
  auditLogs          AuditLog[]
  paymentMethods     PaymentMethod[]
  paymentClaims      PaymentClaim[]
}

model User {
  id                        String     @id @default(cuid())
  tenantId                  String
  name                      String
  email                     String     @unique
  passwordHash              String
  role                      Role       @default(ADMIN)
  isActive                  Boolean    @default(true)
  twoFactorSecret           String?
  twoFactorEnabled          Boolean    @default(false)
  twoFactorBackupCodeHashes String[]   @default([])
  createdAt                 DateTime   @default(now())
  tenant                    Tenant     @relation(fields: [tenantId], references: [id])
  auditLogs                 AuditLog[]
  reviewedPaymentClaims     PaymentClaim[]

  @@index([tenantId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  userName   String
  userEmail  String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model Customer {
  id        String     @id @default(cuid())
  tenantId  String
  publicId  String     @unique @default(uuid())
  name      String
  phone     String
  address   String?
  notes     String?
  telegramChatId               String?
  telegramNotificationsEnabled Boolean @default(true)
  telegramBroadcastsEnabled    Boolean @default(true)
  notificationLanguage         NotificationLanguage @default(AR)
  broadcastRecipients          BroadcastRecipient[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  contracts Contract[]

  @@index([tenantId, name])
  @@index([tenantId, phone])
}

model Contract {
  id                String            @id @default(cuid())
  tenantId          String
  customerId        String
  publicId          String            @unique @default(uuid())
  productName       String
  productPrice      Int
  downPayment      Int
  totalAmount       Int
  calculationMethod CalculationMethod
  markupPercent     Float?
  installmentCount  Int
  recurrenceType    RecurrenceType
  intervalDays      Int?
  startDate         DateTime          @db.Date
  firstPaymentDate  DateTime          @db.Date
  status            ContractStatus    @default(ACTIVE)
  createdAt         DateTime          @default(now())
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  customer          Customer          @relation(fields: [customerId], references: [id])
  installments      Installment[]
  payments          Payment[]
  paymentClaims     PaymentClaim[]

  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model Installment {
  id          String              @id @default(cuid())
  tenantId    String
  contractId  String
  sequence    Int
  dueDate     DateTime            @db.Date
  amount      Int
  paidAmount  Int                 @default(0)
  status      InstallmentStatus   @default(PENDING)
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  contract    Contract            @relation(fields: [contractId], references: [id])
  allocations PaymentAllocation[]
  paymentClaims PaymentClaim[]

  @@unique([contractId, sequence])
  @@index([tenantId, dueDate, status])
}

model Payment {
  id          String              @id @default(cuid())
  tenantId    String
  contractId  String
  amount      Int
  paidAt      DateTime            @default(now())
  note        String?
  createdAt   DateTime            @default(now())
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  contract    Contract            @relation(fields: [contractId], references: [id])
  allocations PaymentAllocation[]

  @@index([tenantId, paidAt])
  @@index([tenantId, contractId])
}

model PaymentAllocation {
  id            String      @id @default(cuid())
  paymentId     String
  installmentId String
  amount        Int
  payment       Payment     @relation(fields: [paymentId], references: [id])
  installment   Installment @relation(fields: [installmentId], references: [id])

  @@index([paymentId])
  @@index([installmentId])
}

model ReminderLog {
  id       String   @id @default(cuid())
  tenantId String
  sentAt   DateTime @default(now())
  success  Boolean
  error    String?
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, sentAt])
}

model Broadcast {
  id         String              @id @default(cuid())
  tenantId   String
  body       String
  hasImage   Boolean             @default(false)
  audience   BroadcastAudience
  status     BroadcastStatus     @default(QUEUED)
  createdAt  DateTime            @default(now())
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  recipients BroadcastRecipient[]

  @@index([tenantId, createdAt])
}

model BroadcastRecipient {
  id          String                   @id @default(cuid())
  tenantId    String
  broadcastId String
  customerId  String
  status      BroadcastRecipientStatus @default(PENDING)
  sentAt      DateTime?
  error       String?
  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  broadcast   Broadcast                @relation(fields: [broadcastId], references: [id])
  customer    Customer                 @relation(fields: [customerId], references: [id])

  @@index([broadcastId, status])
  @@index([customerId])
}

model PaymentMethod {
  id        String         @id @default(cuid())
  tenantId  String
  label     String
  details   String
  presetKey String?
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  claims    PaymentClaim[]

  @@unique([tenantId, presetKey, details])
  @@index([tenantId, isActive])
}

model PaymentClaim {
  id               String             @id @default(cuid())
  tenantId         String
  contractId       String
  installmentId    String
  paymentMethodId  String
  amount           Int
  screenshotUrl    String
  status           PaymentClaimStatus @default(PENDING)
  declineReason    String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  contract         Contract           @relation(fields: [contractId], references: [id])
  installment      Installment        @relation(fields: [installmentId], references: [id])
  paymentMethod    PaymentMethod      @relation(fields: [paymentMethodId], references: [id])
  reviewedBy       User?              @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([installmentId])
}
